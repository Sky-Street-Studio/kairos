{
  "name": "@kairos/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "cargo build --release -p kairos-cli && electron-vite build && electron-builder --mac dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@kairos/napi": "workspace:*",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@kairos/theme": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.55.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "studio.skystreet.kairos",
    "productName": "Kairos",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "../../crates/kairos-player/pkg",
        "to": "kairos-player"
      },
      {
        "from": "../../target/release/kairos",
        "to": "kairos"
      },
      {
        "from": "../../examples/hello-kairos",
        "to": "template"
      },
      {
        "from": "../../crates/kairos-napi",
        "to": "kairos-napi",
        "filter": [
          "index.js",
          "package.json",
          "*.node",
          "*.wasm",
          "*.cjs"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/sharp/**"
    ]
  },
  "productName": "Kairos"
}
