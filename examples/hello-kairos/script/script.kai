character e "Eileen" color="#c8ffc8"
character k "Kai"

define player_name = "Traveler"
default curious = 0
default met_kai = False
default inventory = ["key", "map", "potion"]
default selected_item = "key"

label splashscreen:
    "A little story is getting ready."
    return

label start:
    show screen phone
    scene bg room with fade
    play music "theme.ogg" loop
    show e happy at center with dissolve
    stage e x=16 scale=1.05 over=0.3 ease
    camera zoom=1.02 over=0.3 linear
    shake 0.2 2
    flash "#ffffff" 0.1
    e "{b}Welcome{/b} to Kairos, [player_name]."
    nvl on
    "The room hums quietly. {w=0.3}Outside, {rb}日本語{/rb}{rt}にほんご{/rt} waits on the sign."
    "Tonight, the city feels close."
    nvl clear
    nvl off
    menu:
        e "What would you like to know?"
        "Tell me about the engine":
            $ curious += 1
            jump about
        "Who else is here?":
            call meet_kai
            jump about
        "Nothing, thanks":
            jump goodbye

label about:
    show e thinking
    e "Kairos runs your story in Rust, so rollback and saves just work."
    if curious > 0 and not met_kai:
        e "You asked first. I like that."
    elif met_kai:
        e "Kai can tell you the rest."
    else:
        e "Ask me anything."
    menu:
        "Meet Kai" if not met_kai:
            call meet_kai
        "That's enough":
            pass
    jump goodbye

label meet_kai:
    show k neutral at right
    k "Hi. I'm Kai."
    $ met_kai = True
    return

label goodbye:
    hide k
    stop music fadeout 1.0
    e "See you, [player_name]. Curiosity: [curious]."
    pause 0.5
    return
